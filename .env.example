# Optional browser executable. Leave empty to use installed Google Chrome.
FOOD_BROWSER_PATH=
# SQLite directory. Desktop defaults to ~/Library/Application Support/com.freefood.desktop;
# browser development defaults to .data/food. Leave unset to use these defaults.
# FOOD_DATA_DIR=
# Optional old directory containing .enc files and session.key for import.
# FOOD_LEGACY_DATA_DIR=
# Optional 64-character hexadecimal encryption key for headless deployments or tests.
# Leave unset on macOS to use the system keychain.
# FOOD_SESSION_KEY=
# Allow private-network API requests; enabled by dev:lan and start:lan.
FOOD_ALLOW_LAN=0
# Optional custom WeChat radium/users directory for computer Xiaochan and Waimai connections.
FOOD_WECHAT_DATA_DIR=
# Optional Chrome user data directory for Meituan browser connection.
FOOD_CHROME_DATA_DIR=
